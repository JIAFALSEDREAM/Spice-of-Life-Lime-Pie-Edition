{
  "name": "sollimepie-config-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^26.13.0"
  },
  "scripts": {
    "generate": "python3 build.py",
    "dev": "npm run generate && vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run generate && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vue-tsc": "^3.3.14"
  }
}
